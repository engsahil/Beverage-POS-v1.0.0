# Server-only values (never expose these through VITE_* variables)
DATABASE_URL=postgresql://user:password@database-host:5432/beverage_pos?sslmode=require
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-before-first-production-seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_BUSINESS_NAME=Beverage POS

# Frontend build-time values (public URLs only)
VITE_API_BASE_URL=http://localhost:4000
VITE_POS_URL=http://localhost:5173

# Optional integrations (server only)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
